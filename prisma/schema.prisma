// -----------------------------------------------------------------------
// CONFIGURACIÓN PRINCIPAL
// -----------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------
// ENUMS (Listas de valores restringidos)
// -----------------------------------------------------------------------

enum Role {
  SUPERUSUARIO
  GERENTE
  ADMINISTRADOR
  AUXILIAR_ADMINISTRATIVO
  TECNICO
}

enum ItemCategory {
  LAVADERO
  SERVITECA
  LUBRICANTES
  ACCESORIOS
}

enum OrderStatus {
  EN_PISTA
  FACTURADA
  CANCELADA
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum MovementType {
  INGRESO
  AJUSTE
  VENTA
}

enum WhatsAppStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AppointmentStatus {
  PENDIENTE
  CUMPLIDA
  PERDIDA
  CANCELADA
}

enum ReleaseStatus {
  DRAFT
  PUBLISHED
}

enum FeatureType {
  FEATURE
  IMPROVEMENT
  FIX
  CHANGE
}

// -----------------------------------------------------------------------
// MODELOS DE USUARIO Y PERSONAL
// -----------------------------------------------------------------------

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cc           String        @unique /// Cédula de Ciudadanía - Usuario de acceso
  name         String
  email        String?       @unique
  celular      String?
  passwordHash String        @map("password_hash")
  role         Role          @default(TECNICO)
  department   ItemCategory?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relaciones
  ordersAsTech        Order[]             @relation("TechnicianOrders")
  ordersAsAdmin       Order[]             @relation("AdminOrders")
  stockMoves          InventoryMovement[] @relation("AdminMovements")
  attendance          AttendanceRecord[]
  createdAppointments Appointment[]       @relation("CreatedAppointments")
  cashClosures        CashClosure[]
  productSales        ProductSale[]       @relation("AdminSales")
  releasesAuthored    AppRelease[]        @relation("AuthorReleases")
  releaseViews        ReleaseView[]

  @@index([cc]) // Índice para login rápido
  @@map("users")
}

model AttendanceRecord {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  date     DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  clockIn  DateTime  @default(now()) @map("clock_in")
  clockOut DateTime? @map("clock_out")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clockIn])
  @@map("attendance_records")
}

// -----------------------------------------------------------------------
// MODELOS DE CLIENTES Y VEHÍCULOS
// -----------------------------------------------------------------------

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cc        String?  @unique /// Cédula de Ciudadanía
  name      String?
  phone     String? /// WhatsApp para recordatorios
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  aliaddoId String?  @map("aliaddo_id") /// Identificador del cliente en Aliaddo

  vehicles     Vehicle[]
  appointments Appointment[]

  @@map("customers")
}

model Vehicle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plate      String   @unique
  brand      String?
  model      String?
  color      String?
  customerId String?  @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer     Customer?     @relation(fields: [customerId], references: [id])
  orders       Order[]
  appointments Appointment[]

  @@index([plate]) // Índice para búsqueda rápida en la pista
  @@map("vehicles")
}

// -----------------------------------------------------------------------
// MODELOS DE INVENTARIO Y SERVICIOS (CATÁLOGO)
// -----------------------------------------------------------------------

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]
  services ServiceCatalog[]

  @@map("categories")
}

model Product {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barCode          String?       @unique @map("bar_code")
  name             String
  slug             String        @unique
  imageUrl         String?       @map("image_url") /// URL de imagen del producto (opcional)
  description      String? /// Descripción del producto (opcional)
  category         ItemCategory?
  categoryId       String?       @map("category_id") @db.Uuid
  stock            Int           @default(0)
  unitCost         Decimal       @map("unit_cost") @db.Decimal(10, 2) /// Costo de compra
  salePrice        Decimal       @map("sale_price") @db.Decimal(10, 2) /// Precio de venta
  profitPercentage Decimal?      @map("profit_percentage") @db.Decimal(5, 2) /// % Ganancia (Exclusivo Gerencia)
  iva              Decimal?      @default(19) @map("iva") @db.Decimal(5, 2) /// % IVA
  isActive         Boolean       @default(true) @map("is_active") /// Soft delete
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category_rel  Category?           @relation(fields: [categoryId], references: [id])
  orderProducts OrderProduct[]
  saleItems     ProductSaleItem[]   @relation("SaleItems")
  movements     InventoryMovement[]

  @@map("products")
}

model ServiceCatalog {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  category         ItemCategory?
  categoryId       String?       @map("category_id") @db.Uuid
  basePrice        Decimal       @map("base_price") @db.Decimal(10, 2)
  profitPercentage Decimal?      @map("profit_percentage") @db.Decimal(5, 2) /// % Ganancia (Exclusivo Gerencia)
  description      String?
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  aliaddoItemCode  String?       @map("aliaddo_item_code")

  category_rel  Category?      @relation(fields: [categoryId], references: [id])
  orderServices OrderService[]

  @@map("service_catalog")
}

// -----------------------------------------------------------------------
// TABLA DE AUDITORÍA (NIVEL PRODUCCIÓN)
// -----------------------------------------------------------------------

model InventoryMovement {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  adminId       String       @map("admin_id") @db.Uuid /// Quién hizo el movimiento
  type          MovementType
  quantity      Int /// Cantidad agregada o descontada
  previousStock Int          @map("previous_stock")
  newStock      Int          @map("new_stock")
  reason        String? /// Ej: "Ingreso de nueva mercancía" o "Venta Orden #12"
  createdAt     DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  admin   User    @relation("AdminMovements", fields: [adminId], references: [id])

  @@map("inventory_movements")
}

// -----------------------------------------------------------------------
// MODELOS OPERATIVOS (PISTA Y CAJA)
// -----------------------------------------------------------------------

model CashClosure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  totalCash     Decimal  @map("total_cash") @db.Decimal(10, 2)
  totalCard     Decimal  @map("total_card") @db.Decimal(10, 2)
  totalTransfer Decimal  @map("total_transfer") @db.Decimal(10, 2)
  reportedCash  Decimal  @map("reported_cash") @db.Decimal(10, 2)
  discrepancy   Decimal  @db.Decimal(10, 2)
  observations  String?
  adminId       String   @map("admin_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  admin        User          @relation(fields: [adminId], references: [id])
  orders       Order[]
  productSales ProductSale[]

  @@map("cash_closures")
}

model Order {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber  Int     @unique @default(autoincrement()) @map("order_number")
  technicianId String  @map("technician_id") @db.Uuid
  adminId      String? @map("admin_id") @db.Uuid
  vehicleId    String  @map("vehicle_id") @db.Uuid

  status        OrderStatus    @default(EN_PISTA)
  paymentMethod PaymentMethod? @map("payment_method")

  totalServices Decimal @default(0) @map("total_services") @db.Decimal(10, 2)
  totalProducts Decimal @default(0) @map("total_products") @db.Decimal(10, 2)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(10, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  billedAt  DateTime? @map("billed_at") /// Fundamental para el cuadre de caja exacto

  aliaddoInvoiceId     String? @map("aliaddo_invoice_id")
  cufe                 String?
  aliaddoInvoiceStatus String? @map("aliaddo_invoice_status")

  nextMaintenanceDate   DateTime? @map("next_maintenance_date") @db.Date
  nextMaintenanceReason String?   @map("next_maintenance_reason")

  technician User    @relation("TechnicianOrders", fields: [technicianId], references: [id])
  admin      User?   @relation("AdminOrders", fields: [adminId], references: [id])
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])

  cashClosureId String?      @map("cash_closure_id") @db.Uuid
  cashClosure   CashClosure? @relation(fields: [cashClosureId], references: [id])

  services              OrderService[]
  products              OrderProduct[]
  whatsappNotifications WhatsAppNotification[]

  @@index([createdAt]) // Índice para acelerar la carga de cuadres de caja diarios
  @@index([status]) // Índice para filtrar rápido las órdenes "EN_PISTA"
  @@map("orders")
}

model OrderService {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  serviceId    String  @map("service_id") @db.Uuid
  chargedPrice Decimal @map("charged_price") @db.Decimal(10, 2) /// Precio inmutable al momento de facturar

  order   Order          @relation(fields: [orderId], references: [id])
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@map("order_services")
}

model OrderProduct {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2) /// Precio de venta inmutable
  unitCost  Decimal @map("unit_cost") @db.Decimal(10, 2) /// Costo inmutable para calcular ganancias reales

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_products")
}

// -----------------------------------------------------------------------
// MÓDULO ALMACÉN — Ventas directas de productos con IVA
// -----------------------------------------------------------------------

model ProductSale {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleNumber Int    @unique @default(autoincrement()) @map("sale_number")
  adminId    String @map("admin_id") @db.Uuid

  customerName String? @map("customer_name") /// Consumidor final si es null
  customerCc   String? @map("customer_cc")

  paymentMethod PaymentMethod @map("payment_method")
  subtotal      Decimal       @db.Decimal(10, 2) /// Suma de (unitPrice * qty) antes de IVA
  ivaAmount     Decimal       @map("iva_amount") @db.Decimal(10, 2) /// IVA total de la venta
  grandTotal    Decimal       @map("grand_total") @db.Decimal(10, 2) /// subtotal + ivaAmount

  aliaddoInvoiceId     String? @map("aliaddo_invoice_id")
  cufe                 String?
  aliaddoInvoiceStatus String? @map("aliaddo_invoice_status")
  aliaddoConsecutive   String? @map("aliaddo_consecutive")

  cashClosureId String? @map("cash_closure_id") @db.Uuid /// Para incluir en cierre de caja

  soldAt DateTime @default(now()) @map("sold_at")

  admin       User              @relation("AdminSales", fields: [adminId], references: [id])
  items       ProductSaleItem[]
  cashClosure CashClosure?      @relation(fields: [cashClosureId], references: [id])

  @@index([soldAt])
  @@map("product_sales")
}

model ProductSaleItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2) /// salePrice inmutable al momento de venta
  unitCost  Decimal @map("unit_cost") @db.Decimal(10, 2) /// Costo inmutable para reportes de ganancia
  ivaRate   Decimal @default(0) @map("iva_rate") @db.Decimal(5, 2) /// % IVA del producto en el momento de venta

  sale    ProductSale @relation(fields: [saleId], references: [id])
  product Product     @relation("SaleItems", fields: [productId], references: [id])

  @@map("product_sale_items")
}

// -----------------------------------------------------------------------
// MODELO DE TRAZABILIDAD (NOTIFICACIONES WHATSAPP)
// -----------------------------------------------------------------------

model WhatsAppNotification {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId    String         @unique @map("message_id") /// ID devuelto por Meta (wa_id)
  phone        String
  templateName String         @map("template_name")
  status       WhatsAppStatus @default(PENDING)
  orderId      String?        @map("order_id") @db.Uuid
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  order Order? @relation(fields: [orderId], references: [id])

  @@index([messageId])
  @@map("whatsapp_notifications")
}

// -----------------------------------------------------------------------
// MODELO DE CITAS / AGENDAMIENTO
// -----------------------------------------------------------------------

model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String            @map("customer_id") @db.Uuid
  vehicleId   String            @map("vehicle_id") @db.Uuid
  createdById String?           @map("created_by_id") @db.Uuid /// Opcional: null cuando se agenda por WhatsApp
  scheduledAt DateTime          @map("scheduled_at")
  status      AppointmentStatus @default(PENDIENTE)
  description String? /// Motivo de la cita (ej: "Cambio de aceite")
  notes       String? /// Notas adicionales
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  createdBy User?    @relation("CreatedAppointments", fields: [createdById], references: [id])

  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

// -----------------------------------------------------------------------
// MODELO DE NOTIFICACIONES DEL SISTEMA (CAMPANA)
// -----------------------------------------------------------------------

model AppNotification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String // ej: 'stock_low', 'appointment_rescheduled'
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@index([createdAt])
  @@map("app_notifications")
}

// -----------------------------------------------------------------------
// MODELOS DE RELEASE NOTES / NOVEDADES
// -----------------------------------------------------------------------

model AppRelease {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     String        @unique /// Versión editorial, ej: "2.4.0"
  title       String /// Título de la actualización
  summary     String? /// Resumen general
  status      ReleaseStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorId    String        @map("author_id") @db.Uuid

  author   User             @relation("AuthorReleases", fields: [authorId], references: [id])
  features ReleaseFeature[]
  views    ReleaseView[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@map("app_releases")
}

model ReleaseFeature {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseId   String      @map("release_id") @db.Uuid
  type        FeatureType
  title       String
  description String?     @db.Text

  release AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@map("release_features")
}

model ReleaseView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  releaseId String   @map("release_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  release AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@map("release_views")
}
